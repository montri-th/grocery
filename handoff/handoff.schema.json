{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CityMETER Grocery developer contracts",
  "description": "Shared envelope for product-statement.json, product-brief.json, implementation-plan.json and handoff-manifest.json of CityMETER · Grocery. 1.0.0 (2026-10-22) carries the structure of CityMETER Luxury Brands schema 1.3.0 over to an administrative hierarchy: the product brief requires the hierarchy contract (ประเทศไทย › จังหวัด › อำเภอ/เขต › อปท./ย่าน), the population comparison of the first Aha, the metric contract (count / density.capita) and the stores layer contract instead of neighborhood cores, host buildings and venue x-ray.",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentType",
    "productId"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0"
      ]
    },
    "documentType": {
      "enum": [
        "product-statement",
        "product-brief",
        "implementation-plan",
        "handoff-manifest"
      ]
    },
    "productId": {
      "const": "citymeter-grocery"
    },
    "productVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updatedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "documentType": {
            "const": "product-statement"
          }
        }
      },
      "then": {
        "required": [
          "updatedOn",
          "dataset_id",
          "positioning",
          "users",
          "problem",
          "competitor_landscape",
          "winning_strategy",
          "data_transparency",
          "known_limitations",
          "hypotheses_to_validate"
        ],
        "properties": {
          "positioning": {
            "type": "object",
            "required": [
              "one_line_highlight",
              "unique_advantage",
              "unique_vs_competitors"
            ]
          },
          "users": {
            "type": "object",
            "required": [
              "primary_users",
              "functional_needs",
              "emotional_needs",
              "trigger_voice_in_head",
              "value_proposition"
            ]
          },
          "problem": {
            "type": "object",
            "required": [
              "statement",
              "urgency",
              "severity"
            ]
          },
          "competitor_landscape": {
            "type": "object",
            "required": [
              "present_competitors",
              "aspirational_competitors",
              "expected_quality_bar"
            ],
            "properties": {
              "present_competitors": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "how_users_use_it",
                    "strength",
                    "gap"
                  ]
                }
              }
            }
          },
          "winning_strategy": {
            "type": "array",
            "minItems": 3
          },
          "hypotheses_to_validate": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "hypothesis",
                "test",
                "criterion"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "documentType": {
            "const": "product-brief"
          }
        }
      },
      "then": {
        "required": [
          "updatedOn",
          "firstAha",
          "data",
          "visualSystem",
          "invariants",
          "chartContracts",
          "rowScopes",
          "mapFocusContract",
          "panel",
          "hierarchyContract",
          "metricContract",
          "breadcrumbContract",
          "cameraContract",
          "basemapContract",
          "massingContract",
          "storesLayerContract",
          "pictogramContract",
          "venueLogoContract"
        ],
        "properties": {
          "firstAha": {
            "type": "object",
            "required": [
              "scope",
              "ranking",
              "numerator",
              "denominator",
              "populationComparison",
              "action",
              "model",
              "defaultSnapshot",
              "fallbacks"
            ]
          },
          "rowScopes": {
            "type": "object",
            "required": [
              "filtered",
              "scopeRows",
              "rows"
            ]
          },
          "mapFocusContract": {
            "type": "object",
            "required": [
              "principle",
              "states",
              "choropleth"
            ]
          },
          "panel": {
            "type": "object",
            "required": [
              "modes",
              "actions",
              "models"
            ]
          },
          "hierarchyContract": {
            "type": "object",
            "required": [
              "levels",
              "membership",
              "keys",
              "children"
            ]
          },
          "metricContract": {
            "type": "object",
            "required": [
              "metrics",
              "classification",
              "evidenceStates"
            ]
          },
          "breadcrumbContract": {
            "type": "object",
            "required": [
              "levels",
              "productionPath",
              "demoQuery"
            ]
          },
          "cameraContract": {
            "type": "object",
            "required": [
              "presets",
              "fitting"
            ]
          },
          "basemapContract": {
            "type": "object",
            "required": [
              "generator",
              "tiles",
              "palette"
            ]
          },
          "massingContract": {
            "type": "object",
            "required": [
              "cityTier",
              "focusTier"
            ]
          },
          "storesLayerContract": {
            "type": "object",
            "required": [
              "dots",
              "pins",
              "focus"
            ]
          },
          "invariants": {
            "type": "array",
            "minItems": 10,
            "items": {
              "type": "object",
              "required": [
                "id",
                "rule"
              ]
            }
          },
          "chartContracts": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "viewKey",
                "title",
                "question",
                "encoding",
                "metric",
                "scope"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "documentType": {
            "const": "implementation-plan"
          }
        }
      },
      "then": {
        "required": [
          "updatedOn",
          "architecture",
          "selection",
          "tasks",
          "acceptanceCriteria",
          "developerWorkflow",
          "backlog"
        ],
        "properties": {
          "architecture": {
            "type": "object",
            "required": [
              "runtime",
              "commands",
              "libraries",
              "modules"
            ]
          },
          "selection": {
            "type": "object",
            "required": [
              "filterFields",
              "queryFields",
              "rowScopes",
              "panelActions"
            ]
          },
          "tasks": {
            "type": "array",
            "minItems": 8,
            "items": {
              "type": "object",
              "required": [
                "id",
                "dependsOn",
                "acceptanceCriteria",
                "files",
                "status"
              ]
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 14,
            "items": {
              "type": "object",
              "required": [
                "id",
                "scenario",
                "expected",
                "verificationType"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "documentType": {
            "const": "handoff-manifest"
          }
        }
      },
      "then": {
        "required": [
          "generatedOn",
          "sourceCommit",
          "hashAlgorithm",
          "fileCount",
          "files"
        ],
        "properties": {
          "sourceCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "hashAlgorithm": {
            "const": "SHA-256"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "bytes",
                "sha256"
              ],
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  ]
}
